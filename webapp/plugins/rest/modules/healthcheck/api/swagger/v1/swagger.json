{
    "swagger": "2.0",
    "info": {
        "version": "1.0.0",
        "title": "Plugin rest-healthcheck",
        "description": "Rest-healthcheck API"
    },
    "produces": [
        "application/json"
    ],
    "paths": {
        "/health": {
            "get": {
                "description": "Run every health check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "Every check is up",
                        "schema": {
                            "$ref": "#/definitions/HealthResult"
                        }
                    },
                    "404": {
                        "description": "Version not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "A check is down, or no check is active",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                }
            }
        },
        "/health/ready": {
            "get": {
                "description": "Run the readiness checks",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "Every readiness check is up",
                        "schema": {
                            "$ref": "#/definitions/HealthResult"
                        }
                    },
                    "404": {
                        "description": "Version not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "A check is down, or no check is active",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                }
            }
        },
        "/health/live": {
            "get": {
                "description": "Run the liveness checks",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "Every liveness check is up",
                        "schema": {
                            "$ref": "#/definitions/HealthResult"
                        }
                    },
                    "404": {
                        "description": "Version not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "503": {
                        "description": "A check is down, or no check is active",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Error": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "errorCode": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "HealthResult": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "result": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Check"
                    }
                }
            }
        },
        "Check": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "UP",
                        "DOWN"
                    ]
                },
                "data": {
                    "type": "object"
                }
            }
        }
    }
}
